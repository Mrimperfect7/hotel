{
  "expo": {
    "name": "NammaGuruvayoor",
    "slug": "namma-guruvayoor",
    "scheme": "nammaguruvayoor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1e3a6e",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nammaguruvayoor.app"
    },
    "android": {
      "package": "com.nammaguruvayoor.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a6e"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiOrigin": "http://192.168.1.17:4000",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "25d5379c-1009-46c8-9904-fc50e1777beb"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "nammagvr"
  }
}
