# ──────────────────────────────────────────────────────────────────────────────
# Guruvayoor Stay — environment configuration
# Copy to .env at the REPO ROOT. `apps/api` and `apps/web` read it from there.
# NEVER commit the real .env. Values below are dev defaults / placeholders.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public web origin (CORS allow-list, links in emails)
WEB_ORIGIN=http://localhost:3000
# Public API origin (used by web/mobile clients)
API_ORIGIN=http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
# Local embedded dev DB (scripts/dev-db.mjs) or Docker (docker-compose.yml).
DATABASE_URL=postgresql://gsv:gsv@localhost:5433/guruvayoor_stay?schema=public

# ── Auth (generate with: openssl rand -base64 48) ────────────────────────────
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Demo admin (DEVELOPMENT ONLY — seeded from these vars) ───────────────────
# In production create the super admin via: npm run admin:create -w @gsv/database
DEMO_ADMIN_EMAIL=admin@guruvayoorstay.test
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_ADMIN_NAME=Platform Admin

# ── Payments: Razorpay (India) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# When no Razorpay keys are configured the API runs in MOCK payment mode:
# orders are simulated and the confirm endpoint succeeds deterministically.
PAYMENT_MOCK=1

# ── Maps: Google Maps Platform ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Guruvayoor Sri Krishna Temple reference coordinates (Kerala, India)
TEMPLE_LAT=10.5945
TEMPLE_LNG=76.2075

# ── Media storage: Cloudinary ────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Push notifications: Firebase Cloud Messaging ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Email: Resend (or SendGrid-compatible) ───────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Guruvayoor Stay <no-reply@guruvayoorstay.test>"

# ── SMS (Indian provider abstraction: gupshup/msg91/twilio adapters) ─────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=GURUVY

# ── WhatsApp Business API abstraction ────────────────────────────────────────
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
